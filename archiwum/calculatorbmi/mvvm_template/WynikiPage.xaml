<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="mvvm_template.WynikiPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout Padding="20">
        <Label FontSize="24" Text="{Binding Bmi}" />
        <Label
            BackgroundColor="{Binding KolorWyniku}"
            FontSize="20"
            Text="{Binding Wynik}" />
        <Button Command="{Binding WrocCommand}" Text="Wróć do kalkulatora" />
    </VerticalStackLayout>

</ContentPage>