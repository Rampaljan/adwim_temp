<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pesele_menele.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Decoder:"
                />

            <Entry x:Name="entry"
                Placeholder="Enter text"/>

            <Button
                x:Name="CounterBtn"
                Text="Dekoduj"
                Clicked="Dekodowanie"
                HorizontalOptions="Fill" />

            <Button
                x:Name="CounterBtn2"
                Text="" 
                HorizontalOptions="Fill" 
                BackgroundColor="White"
                TextColor="Black"
                />

            <Label
                Text="Encoder:"
                />

            <Entry x:Name="entry_rok"
                Placeholder="Podaj Rok"/>
            <Entry x:Name="entry_miesiac"
                Placeholder="Podaj Miesiąc"/>
            <Entry x:Name="entry_dzien"
                Placeholder="Podaj Dzień"/>
            <Entry x:Name="entry_plec"
                Placeholder="K/M"/>

            <Button
                x:Name="EncodeBtn"
                Text="Encoduj"
                Clicked="Encodowanie"
                HorizontalOptions="Fill" />

            <Button
                x:Name="WynikEncodowania"
                Text="" 
                HorizontalOptions="Fill" 
                BackgroundColor="White"
                TextColor="Black"
                />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
