<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="todoapp.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Entry Text="{Binding Pole}"></Entry>
            <Label Text="{Binding Odpowiedz}"></Label>
            <Button Text="Kliknij mnie" Command="{Binding dupaCommand}"></Button>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
