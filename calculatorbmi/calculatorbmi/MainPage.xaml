<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculatorbmi.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <!--todo: zabezpieczenie przed wpisaniem cos innego niz liczba i przycisk oblicz aktywny tylko jak oba pola są wpisane-->
            
            <Entry x:Name="waga"
               Placeholder="waga"
            />
            <Entry x:Name="wzrost"
             Placeholder="wzrost"
            />

            <Button x:Name="oblicz"
                    Text="Oblicz"
                    Clicked="obliczanie"/>

            <Label Text="{Binding Obliczanie}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
