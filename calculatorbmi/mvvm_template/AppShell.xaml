<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mvvm_template.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:mvvm_template"
    Title="mvvm_template">

    <TabBar>
        <Tab Title="Kalkulator BMI">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Ustawienia">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage" />
        </Tab>

        <Tab Title="Wyniki">
            <ShellContent ContentTemplate="{DataTemplate local:WynikiPage}" Route="WynikiPage" />
        </Tab>
    </TabBar>

</Shell>