<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Notes.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Notes.App"
    Title="Notatki">

    <FlyoutItem Title="Lista notatek" Icon="notka.png">
        <ShellContent
        ContentTemplate="{DataTemplate local:NotesList}"/>
    </FlyoutItem>

    <FlyoutItem Title="Lista kategorii" Icon="kateg.png">
        <ShellContent
        ContentTemplate="{DataTemplate local:CategoryList}"/>
    </FlyoutItem>


</Shell>
