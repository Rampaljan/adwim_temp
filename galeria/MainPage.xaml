<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="galeria.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="{Binding Title}"/>
            <Label Text="{Binding Opis}"/>
            <Label Text="{Binding Likes}"/>
            <Button Command="{Binding likeCommand}" Text="Polób"/>
            <Button Command="{Binding unlikeCommand}" Text="Usuń"/>
            <Button Command="{Binding locCommand}" Text="Lokalizacja"/>
            <Button Command="{Binding nextCommand}" Text="Następne"/>
            <Button Command="{Binding prevCommand}" Text="Poprzednie"/>
            <Image Source="{Binding Path}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
